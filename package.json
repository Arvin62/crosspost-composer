{
  "name": "crosspost-composer",
  "version": "1.0.0",
  "description": "一次插图，多平台粘贴 —— 面向公众号 / 知乎 / 头条号 / 汽车之家等平台的本地图文排版工具。Compose once, paste everywhere.",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm test && npm run typecheck && npm run build",
    "audit:ci": "npm audit --audit-level=moderate",
    "security:secrets": "node scripts/check-repository-secrets.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.7"
  }
}
